<?xml version="1.0" encoding="utf-8"?>
<!--
  Die App speichert den Token in EncryptedSharedPreferences; der Master-Key liegt im
  Android-Keystore und wird NIE mitgesichert/übertragen. Werden die verschlüsselten Prefs auf
  ein anderes Gerät gebracht (Cloud-Backup oder Gerät-zu-Gerät-Transfer ab Android 12), fehlt
  dort der Key und die Werte sind unlesbar. Deshalb Shared Preferences von beidem ausschließen —
  der Nutzer trägt URL/Token/Entity nach einem Gerätewechsel einfach neu ein.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
